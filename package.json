{
  "name": "livecg",
  "private": true,
  "version": "0.1.0",
  "description": "实时字幕图文系统：面向电竞与传统体育直转播的在线包装（CG）平台",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @livecg/control build",
    "start": "pnpm build && pnpm --filter @livecg/server start",
    "dev": "pnpm --parallel --filter @livecg/control --filter @livecg/server dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "sim:cs2": "pnpm --filter @livecg/server sim:cs2",
    "sim:scoreboard": "pnpm --filter @livecg/server sim:scoreboard",
    "replay:cs2": "pnpm --filter @livecg/server replay:cs2",
    "preflight": "pnpm --filter @livecg/server preflight"
  }
}
