# 复制为项目根目录的 .env，服务启动时自动读取（已设置的环境变量优先，空值视为未设置）。
# 主备部署可直接用 deploy/primary.env.example、deploy/backup.env.example。

# 服务端口（图文页面、控制台、WebSocket、数据接入都走这个端口）
PORT=3000
# CS2 GSI 鉴权 token，需与 integrations/cs2/gamestate_integration_livecg.cfg 中一致
CS2_GSI_TOKEN=change-me
# CS2 数据延迟（毫秒），与播出延迟对齐；控制台可实时修改
CS2_DELAY_MS=0

# ── 登录与权限 ──
# 首次启动时管理员（admin）的密码；不设置则随机生成，打印在控制台并写入 data/runtime/initial-admin-password.txt，首次登录必须修改
LIVECG_ADMIN_PASSWORD=
# 输出页令牌：设置后，未登录的输出页（OBS / vMix / CasparCG）地址必须带 &token=<令牌> 才能读取画面数据
LIVECG_OUTPUT_TOKEN=
# 设为 off 关闭鉴权（所有人都是管理员），仅限本机开发
LIVECG_AUTH=
# 设为 1 录制 CS2 原始数据到 <数据目录>/captures/（联调排查用，正式播出时留空）
LIVECG_CS2_CAPTURE=

# ── 主备（双机热备），两台机器互为对端；不配置则为单机 ──
# 对端地址，例如主机上填备机：http://10.0.0.6:3000，备机上填主机：http://10.0.0.5:3000
LIVECG_PEER_URL=
# 两台相同的复制密钥（至少 16 位）
LIVECG_REPLICATION_TOKEN=
# 初始角色：primary 或 backup（启动时若对端已是主机，本机一律以备机启动）
LIVECG_ROLE=primary
