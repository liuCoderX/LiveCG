# 服务端口（图文页面、控制台、WebSocket、数据接入都走这个端口）
PORT=3000
# CS2 GSI 鉴权 token，需与 integrations/cs2/gamestate_integration_livecg.cfg 中一致
CS2_GSI_TOKEN=change-me
# CS2 数据延迟（毫秒），与播出延迟对齐；控制台可实时修改
CS2_DELAY_MS=0

# ── 登录与权限 ──
# 首次启动时管理员（admin）的密码；不设置则随机生成，打印在控制台并写入 data/runtime/initial-admin-password.txt，首次登录必须修改
LIVECG_ADMIN_PASSWORD=
# 输出页令牌：设置后，未登录的输出页（OBS / vMix / CasparCG）地址必须带 &token=<令牌> 才能读取画面数据
LIVECG_OUTPUT_TOKEN=
# 设为 off 关闭鉴权（所有人都是管理员），仅限本机开发
LIVECG_AUTH=
