# ── LiveCG 主机（示例：10.0.0.5）──
# 复制到项目根目录：cp deploy/primary.env.example .env，然后修改带 ★ 的项
# 改完运行 pnpm preflight 自检

PORT=3000
# 数据目录：配置、账号、审计都在这里，要定期备份
LIVECG_DATA_DIR=/var/lib/livecg

# ★ CS2 GSI 令牌：随机字符串，与 CS2 cfg 文件里的 token 一致（主备两台相同）
CS2_GSI_TOKEN=
# ★ 首次启动的管理员密码（至少 8 位，主备两台相同）
LIVECG_ADMIN_PASSWORD=
# 可选：输出页令牌（主备两台相同）；设置后输出页地址需带 &token=
LIVECG_OUTPUT_TOKEN=

# ── 主备（不做主备就把这三项留空）──
# ★ 对端（备机）地址
LIVECG_PEER_URL=http://10.0.0.6:3000
# ★ 复制密钥：至少 16 位随机字符串，主备两台相同
LIVECG_REPLICATION_TOKEN=
LIVECG_ROLE=primary

# 联调时录制 CS2 原始数据（captures/ 目录），正式播出时留空
LIVECG_CS2_CAPTURE=
